# The variable contract uat and prod must satisfy. Descriptions only, no values.
# Local-only variables (WEB_PORT, SEED_DEMO_DATA, LOCAL_SUPERUSER_*) are absent
# on purpose: they have no meaning outside local.

DJANGO_ENV=          # uat | prod
SECRET_KEY=          # required, no default; prod refuses the committed local value
DEBUG=               # must be false outside local; prod refuses to boot if true
ALLOWED_HOSTS=       # comma separated; prod rejects empty and "*"
DATABASE_URL=        # postgres://user:password@host:5432/dbname
CORS_ALLOWED_ORIGINS= # comma separated origins
THROTTLE_ANON=       # e.g. 100/min
THROTTLE_USER=       # e.g. 1000/min
SECRETS_FILE=        # optional path written by the secrets sidecar, read before the environment
AUTH_PROVIDER=       # optional; the identity provider adapter, default pharmacy.auth.providers.logto.LogtoProvider
AUTH_ISSUER=         # required; the provider's issuer URL, what it writes into a token's iss (Logto: https://auth.example.com/oidc)
AUTH_INTERNAL_URL=   # optional; where this service reaches the provider for discovery and keys when that is not the public URL
AUTH_AUDIENCE=       # required; this API's identifier at the provider, the token audience
