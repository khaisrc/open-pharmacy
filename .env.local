# LOCAL ONLY. Committed on purpose so a fresh clone needs no setup.
# Every value here is a throwaway that must never be valid anywhere else.
DJANGO_ENV=local
SECRET_KEY=local-only-insecure-do-not-use-anywhere-else
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Points at the Compose "db" service; no real credential involved. The three
# POSTGRES_* values create that database, so they must agree with the URL.
DATABASE_URL=postgres://pharmacy:pharmacy@db:5432/open_pharmacy
POSTGRES_DB=open_pharmacy
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=pharmacy

CORS_ALLOWED_ORIGINS=http://localhost:3000

# The identity provider: the Compose auth service (Logto) and this API's
# identifier at it. AUTH_ISSUER is the issuer the provider writes into a
# token, on the host port Compose publishes (AUTH_PORT, default 8441);
# AUTH_INTERNAL_URL is where the API fetches its keys, over the Compose
# network.
AUTH_PROVIDER=pharmacy.auth.providers.logto.LogtoProvider
AUTH_ISSUER=http://localhost:8441/oidc
AUTH_INTERNAL_URL=http://auth:3001
AUTH_AUDIENCE=https://api.open-pharmacy.local
# Local-only: the key `manage.py mint_token` signs dev tokens with, which the
# API accepts alongside the provider's (the e2e suite mints its staff this
# way). A throwaway generated for this file; newlines are written as \n.
# Only local.py reads it, so it means nothing anywhere else.
AUTH_DEV_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\nMIG2AgEAMBAGByqGSM49AgEGBSuBBAAiBIGeMIGbAgEBBDAzUUeP+NOR0b2b5ikL\nWSj0zDiLS2bSuO7dRn9gmnwvinxz8BOn+o7YQETZtiifKcehZANiAARoIwiSanQl\noxs6ZdNXHpmq/Ajvp0R3QF7DvkU01CTo5QptHzovWlV7D4coXAD1ktL4LElAGKQr\nWGoeWDEw9D9+cGJLrjZdL/oKHhp9SzxlGd8cTxIkttIgKXs18BFuJPI=\n-----END PRIVATE KEY-----\n
THROTTLE_ANON=100/min
THROTTLE_USER=1000/min

# Local-only: the seeded superuser. (The published port is WEB_PORT in the
# shell -- `WEB_PORT=9000 docker compose up` -- because Compose expands the
# port mapping before any env_file is read.)
SEED_DEMO_DATA=true
LOCAL_SUPERUSER_USERNAME=admin
LOCAL_SUPERUSER_PASSWORD=admin
LOCAL_SUPERUSER_EMAIL=admin@example.local
